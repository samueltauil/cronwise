{
  "name": "cronwise",
  "version": "0.3.0",
  "description": "Explain your cron jobs before they explain themselves at 3am.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "demo:verify": "node scripts/verify-demo.mjs",
    "demo:issues": "node scripts/seed-issues.mjs",
    "demo:issues:list": "node scripts/seed-issues.mjs --list",
    "demo:reset": "node scripts/reset-demo.mjs",
    "demo:reset:all": "node scripts/reset-demo.mjs --remote",
    "demo:retag": "node scripts/retag-demo.mjs"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
